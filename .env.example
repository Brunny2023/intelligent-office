# Supabase project settings (required for authentication and persistent workflows)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Configure this server-side in Supabase Edge Functions when enabling AI generation.
# Never expose a service-role key or AI provider key in VITE_* variables.
AI_GATEWAY_API_KEY=configure-in-supabase-secrets
