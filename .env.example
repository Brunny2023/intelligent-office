# Browser-safe Supabase project settings (required for authenticated workflows)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Supabase Edge Function secrets (server-side only; never use VITE_* prefixes)
AI_GATEWAY_URL=https://your-openai-compatible-gateway.example/v1
AI_GATEWAY_API_KEY=configure-in-supabase-secrets
